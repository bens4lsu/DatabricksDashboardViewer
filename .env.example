# ==============================================================================
# Databricks Service Principal & Workspace Configuration
# ==============================================================================

# 1. Databricks Workspace Instance URL (no trailing slash)
# Example: https://dbc-abcdefg-1234.cloud.databricks.com or https://adb-1234567890123456.7.azuredatabricks.net
DATABRICKS_INSTANCE_URL=https://<your-workspace-instance>.cloud.databricks.com

# 2. Databricks Workspace ID (numeric identifier found in URL ?o=<workspace_id>)
DATABRICKS_WORKSPACE_ID=1234567890123456

# 3. Published AI/BI (Lakeview) Dashboard ID (UUID from dashboard URL)
DATABRICKS_DASHBOARD_ID=01ef0000-0000-0000-0000-000000000000

# 4. Service Principal Application (Client) ID
DATABRICKS_CLIENT_ID=00000000-0000-0000-0000-000000000000

# 5. Service Principal OAuth Secret (created in Workspace Settings > Service Principals)
DATABRICKS_CLIENT_SECRET=dapi_secret_abcdef1234567890

# 6. Optional Audit and Filter defaults
# Default external viewer identifier (passed to Databricks audit logs; NO PII)
DATABRICKS_DEFAULT_VIEWER_ID=viewer_demo_001

# Default external value (injected into SQL queries via `__aibi_external_value`)
DATABRICKS_DEFAULT_EXTERNAL_VALUE=US_EAST
